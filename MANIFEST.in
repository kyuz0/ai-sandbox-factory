recursive-include ai_sandbox_factory/connectors *.json Dockerfile *.py
recursive-include ai_sandbox_factory/containers *
recursive-include ai_sandbox_factory/profiles *
recursive-include ai_sandbox_factory/providers *
recursive-include ai_sandbox_factory/checks *
recursive-include ai_sandbox_factory/network-catalog *
include ai_sandbox_factory/images.lock.json
global-exclude __pycache__ *.py[cod]

prune ai_sandbox_factory/containers/inference/node_modules
recursive-include ai_sandbox_factory/browser_assets *.html *.css *.js
