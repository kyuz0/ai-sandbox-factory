ARG BASE_IMAGE
FROM ${BASE_IMAGE} AS knowledge-build
USER root
WORKDIR /opt/pi-knowledge
RUN apt-get update \
    && apt-get install -y --no-install-recommends g++ make patch \
    && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json trusted-mounts.patch ./
RUN npm_config_onnxruntime_node_install_cuda=skip npm ci --omit=dev --no-audit --no-fund \
    && patch --batch --forward --fuzz=0 -p1 -d node_modules/pi-knowledge < trusted-mounts.patch \
    && rm trusted-mounts.patch

FROM ${BASE_IMAGE}
COPY --from=knowledge-build /opt/pi-knowledge /opt/pi-knowledge
COPY extension.mjs index-policy.mjs /opt/pi-knowledge/
ENV PI_KNOWLEDGE_OFFLINE=true
